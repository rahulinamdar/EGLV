{
  "_version": "1.40.0",
  "sap.app": {
    "id": "com.demo.prototype",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.7.3",
      "toolsId": "ca8148f3-54ce-45dc-987e-11ecf215d3c5"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/",
        "type": "OData",
        "settings": {
          "annotations": ["annotations"],
          "localUri": "localService/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "annotations":{
        "type": "ODataAnnotation",
				"uri": "annotations/annotations.xml",
				"settings": {
					"localUri": "annotations/annotations.xml"
				}
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.134.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.suite.ui.generic.template": {},
        "sap.ui.comp": {},
        "sap.ui.generic.app": {},
        "sap.ui.table": {},
        "sap.ushell": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.demo.prototype.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "com.demo.prototype.view",
        "controlAggregation": "pages",
        "controlId": "app",
        "clearControlAggregation": false
      },
      "routes": [
        {
          "name": "first",
          "pattern": "first:?query:",
          "target": [
            "first",
            "map"
          ]
        },
        {
          "name": "",
          "pattern": ":?query:",
          "target": [
            "home"
          ]
        },
        {
          "name": "second",
          "pattern": "second:?query:",
          "target": [
            "second",
            "map"
          ]
        },
        {
          "name": "third",
          "pattern": "third:?query:",
          "target": [
            "third",
            "map"
          ]
        },
        {
          "name": "mobsecond",
          "pattern": "mobsecond:?query:",
          "target": [
            "mob2",
            "mobmap"
          ]
        },
        {
          "name": "mobfirst",
          "pattern": "mobfirst:?query:",
          "target": [
            "mob1",
            "mobmap"
          ]
        },
        {
          "name": "mobthird",
          "pattern": "mobthird:?query:",
          "target": [
            "mob3",
            "mobmap"
          ]
        }
      ],
      "targets": {
        "home":{
          "viewType": "XML",
          "viewId": "idHome",
					"viewName": "Home",
					"controlId": "idNavContainer"
        },
        "first": {
          "viewType": "XML",
          "viewId": "idView1",
          "viewName": "View1",
          "controlId": "idVLeftNavContainer",
          "parent": "splitVertical"
        },
        "splitVertical":{
          "viewType": "XML",
          "viewId": "idVertical",
					"viewName": "SplitVertical",
					"controlId": "idNavContainer"
        },
        "second": {
          "viewType": "XML",
          "viewId": "idView2",
          "viewName": "View2",
          "controlId": "idVLeftNavContainer",
          "parent": "splitVertical"
        },
        "third": {
          "viewType": "XML",
          "viewId": "idView3",
          "viewName": "View3",
          "controlId": "idVLeftNavContainer",
          "parent": "splitVertical"
        },
        "map":{
          "viewType": "XML",
          "viewId": "idViewMap",
          "viewName": "Map",
          "controlId": "idVRightNavContainer",
          "parent": "splitVertical"
        },
        "mobmap":{
          "viewType": "XML",
          "viewId": "idViewMap1",
          "viewName": "Map",
          "controlId": "idHLeftNavContainer",
          "parent": "splitHorizontal"
        },
        "mob2": {
          "viewType": "XML",
          "viewId": "idView12",
          "viewName": "View2",
          "controlId": "idHRightNavContainer",
          "parent": "splitHorizontal"
        },
        "mob3": {
          "viewType": "XML",
          "viewId": "idView13",
          "viewName": "View3",
          "controlId": "idHRightNavContainer",
          "parent": "splitHorizontal"
        },
        "mob1": {
          "viewType": "XML",
          "viewId": "idView11",
          "viewName": "View1",
          "controlId": "idHRightNavContainer",
          "parent": "splitHorizontal"
        },
        "splitHorizontal":{
          "viewType": "XML",
          "viewId": "idHorizontal",
					"viewName": "SplitHorizontal",
					"controlId": "idNavContainer"
        }
      }
    },
    "rootView": {
      "viewName": "com.demo.prototype.view.App",
      "type": "XML",
      "async": true,
      "id": "App"
    }
  }
}
