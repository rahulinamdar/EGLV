<mvc:View controllerName="com.demo.prototype.controller.View1"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
	xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns="sap.m">
    <Page id="idPage">
        <content>
        <smartFilterBar:SmartFilterBar id="smartFilterBar" entitySet="TechnicalObjects" persistencyKey="SmartFilter_Explored" enableBasicSearch="false" >
				<!-- layout data used to make the table growing but the filter bar fixed -->
				<smartFilterBar:layoutData>
					<FlexItemData shrinkFactor="0"/>
				</smartFilterBar:layoutData>
			</smartFilterBar:SmartFilterBar>
        <smartTable:SmartTable id="LineItemsSmartTable" entitySet="TechnicalObjects" smartFilterId="smartFilterBar" tableType="ResponsiveTable" enableExport="true" useVariantManagement="true" useTablePersonalisation="true" header="Technical Objects" showRowCount="true" persistencyKey="SmartTableAnalytical_Explored" enableAutoBinding="true" class="sapUiResponsiveContentPadding" enableAutoColumnWidth="true" editTogglable="true"
        initiallyVisibleFields="ObjectID,NoOfOrders,Description,Level">
				<!-- layout data used to make the table growing but the filter bar fixed -->
				<smartTable:layoutData>
					<FlexItemData growFactor="1" baseSize="0%"/>
				</smartTable:layoutData>

					<Table itemPress="itemPress">
			
					<items>
					<ColumnListItem type="Active"></ColumnListItem>
					</items>
		</Table>
			</smartTable:SmartTable>
        </content>
    </Page>
</mvc:View>
